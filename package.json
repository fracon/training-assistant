{
  "name": "training-assistant",
  "version": "1.0.0",
  "description": "1-Page Minimalist .FIT Parser & AI Prompt Generator - Local & Offline",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/start.js",
    "dev": "node --watch src/start.js",
    "test": "node --test",
    "test:coverage": "c8 --include=src/** --exclude=src/public/** --exclude=src/start.js --statements=100 --branches=100 --functions=100 --lines=100 --reporter=text --reporter=html npm run test"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "fit-file-parser": "^1.9.6"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
