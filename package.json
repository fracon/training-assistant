{
  "name": "training-assistant",
  "version": "0.6.4",
  "description": "Self-hosted running training assistant with FIT analysis, training cycles, calendar planning, and AI-ready coaching prompts",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/start.js",
    "dev": "node --watch src/start.js",
    "test": "node --test",
    "test:coverage": "c8 --include=src/** --exclude=src/public/** --exclude=src/start.js --statements=100 --branches=100 --functions=100 --lines=100 --reporter=text --reporter=html npm run test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fit-file-parser": "^1.9.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
