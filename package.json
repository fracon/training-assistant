{
  "name": "training-assistant",
  "version": "0.27.0",
  "description": "Self-hosted running training assistant with FIT analysis, training cycles, calendar planning, and AI-ready training prompts",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/start.js",
    "dev": "node --watch src/start.js",
    "admin:bootstrap": "node scripts/admin-bootstrap.js",
    "admin:promote": "node scripts/admin-promote.js",
    "garmin:pilot": "node scripts/garmin-pilot.js",
    "garmin:setup": "node scripts/garmin-setup.js",
    "garmin:connector": "node scripts/garmin-connector.js",
    "test:garmin-pilot-coverage": "c8 --include=scripts/garmin-pilot.js --include=scripts/garmin-local-config.js --include=scripts/garmin-setup.js --include=scripts/garmin-connector.js --include=src/garmin/product.js --reporter=text node --test test/garminPilot.test.js test/garminLocal.test.js test/garminProduct.routes.test.js test/garminWorkoutContract.test.js",
    "test:garmin-product-coverage": "c8 --include=src/garmin/product.js --include=src/garmin-workout-contract.js --reporter=text node --test test/garminProduct.routes.test.js test/garminWorkoutContract.test.js",
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --include=src/** --include=scripts/admin-prompts.js --include=scripts/admin-runtime.js --include=scripts/admin-commands.js --exclude=src/public/** --exclude=src/start.js --statements=100 --branches=100 --functions=100 --lines=100 --reporter=text --reporter=html node --test --test-concurrency=1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fit-file-parser": "^1.9.6",
    "unzipper": "^0.12.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
