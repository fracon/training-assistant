# Copy this file to .env for local development. Never commit the copied file.
PORT=3000
HOST=127.0.0.1
DATABASE_FILE=./data/database.sqlite

# Optional: Unsplash Access Key (Client-ID). Leave blank for the local fallback.
UNSPLASH_ACCESS_KEY=

# Cycle planning on the issue #63 branch; weekly/analysis operations remain unregistered.
# Full-plan settings evaluated on 2026-10-18: 8192 output tokens (reasoning included),
# 120000ms timeout. Legacy unset/Compose fallbacks remain 2048/60000: set explicitly.
# For a controlled one-attempt evaluation, override AI_RETRIES=0.
# Review daily budgets first; uncertain timeouts can still incur provider charges.
# Inject only at backend runtime; never commit the key. See docs/ai-foundation.md.
# Enable explicitly as well as setting the key; restart dev/start after .env changes.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL_CYCLE=gpt-6.1-sol
AI_MODEL_WORKOUTS=gpt-6.1-sol
AI_MODEL_ANALYSIS=gpt-6.1-sol
AI_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT_MS=120000
AI_CONCURRENCY_USER=1
AI_CONCURRENCY_GLOBAL=2
AI_DAILY_TOKENS_USER=100000
AI_DAILY_TOKENS_GLOBAL=500000
AI_DAILY_CALLS_USER=10
AI_DAILY_CALLS_GLOBAL=100
AI_DAILY_USD_USER=2
AI_DAILY_USD_GLOBAL=20
AI_CONTEXT_TOKENS=12000
AI_DETAIL_DAYS=14
AI_HISTORY_WEEKS=12
AI_RETENTION_DAYS=90
AI_RETRIES=1

# Private Garmin pilot. Leave disabled until the owner's real-device PoC is approved.
# ZimaOS/operator runtime only. Use the protected secret store and keep this file
# mode 0600; never echo secrets to the terminal or put them in shell history/chat.
# ZimaOS/operator runtime only. Local development stores these in the ignored
# .kinesis-private/garmin-pilot.json via `npm run garmin:setup`.
GARMIN_PILOT_ENABLED=false
# Temporary Phase 1 pilot restriction: this is a Kinesis users.id, not a Garmin ID.
GARMIN_PILOT_USER_ID=
# Internal Node-to-Python secret; users do not configure this in production.
KINESIS_GARMIN_SERVICE_TOKEN=
# Internal 32-byte encryption key; back up separately from the token volume.
GARMIN_ENCRYPTION_KEY=
